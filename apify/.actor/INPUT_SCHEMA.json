{
  "title": "FAIR agenda source",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "startUrl": { "title": "Agenda archive URL (optional)", "type": "string", "editor": "textfield", "description": "Leave blank to discover a California city's official .gov website." },
    "cityName": { "title": "City name", "type": "string", "editor": "textfield", "description": "Preserved exactly in dataset records." },
    "maxDepth": { "title": "Maximum link depth", "type": "integer", "default": 4, "minimum": 0, "maximum": 10 },
    "maxPages": { "title": "Maximum document requests", "type": "integer", "default": 200, "minimum": 1, "maximum": 2000 },
    "sameDomainOnly": { "title": "Keep HTML navigation on the starting hostname", "type": "boolean", "default": true },
    "lookbackDays": { "title": "Meeting lookback in days", "type": "integer", "default": 14, "minimum": 0, "maximum": 3650 }
  },
  "required": ["cityName"]
}