{
  "name": "fair-server",
  "version": "1.0.0",
  "description": "FAIR backend server",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "prisma generate && node src/index.js",
    "dev": "node --watch src/index.js",
    "sync:legistar": "node src/jobs/runNightlyLegistarSync.js",
    "backfill:legistar": "node scripts/backfill.js",
    "run:apify-agendas": "node src/jobs/runApifyAgendaScrape.js",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:coverage": "vitest run --coverage tests/unit",
    "benchmark:search": "node scripts/benchmark-search.mjs",
    "test:integration": "vitest run tests/integration",
    "test:functional": "vitest run tests/functional",
    "test:storage": "node scripts/test-form700-storage.mjs",
    "smoke:legistar-api": "node scripts/legistar-api-smoke.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.49.1",
    "apify-client": "^2.23.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fuse.js": "^7.3.0",
    "multer": "^2.3.0",
    "node-cron": "^4.2.1",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.9",
    "puppeteer": "^25.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "prisma": "^6.12.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  }
}
