// Schema v2 (Sprint 5) — core disclosure/agenda tables plus Form 700 schedule
// tables, data_sources and sync_logs.
//
// Naming convention (see supabase/CONTEXT.md):
//   * Prisma models and fields stay camelCase.
//   * Every model is mapped to a snake_case table with @@map and every
//     multi-word field is mapped to a snake_case column with @map, so raw SQL
//     (server/src/jobs/nightlySync.js, Supabase JS queries) and Prisma hit the
//     exact same physical tables/columns.
//   * Primary keys are `uuid` columns with a DB-side default
//     (gen_random_uuid()) rather than Prisma's client-side uuid(), so raw SQL
//     and Supabase JS inserts that omit `id` still succeed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Core v1 tables (now mapped to snake_case)
// ---------------------------------------------------------------------------

model Jurisdiction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  type             String
  legistarClientId String?  @unique @map("legistar_client_id")
  createdAt        DateTime @default(now()) @map("created_at")

  politicians Politician[]
  meetings    Meeting[]
  dataSources DataSource[]

  @@map("jurisdictions")
}

model Politician {
  isDemo         Boolean       @default(false) @map("is_demo")
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String        @unique
  fullName       String        @map("full_name")
  officeTitle    String        @map("office_title")
  party          String?
  district       String?
  photoUrl       String?       @map("photo_url")
  externalId     String?       @map("external_id")
  jurisdictionId String?       @map("jurisdiction_id") @db.Uuid
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  /// Set when a Form 700 filer could not be confidently matched to an existing
  /// politician and a new row was auto-created (see findOrCreatePolitician.js).
  needsReview    Boolean       @default(false) @map("needs_review")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  votes                VoteRecord[]
  filings              Form700Filing[]
  conflictFlags        ConflictFlag[]
  conflicts            Conflict[]
  scheduleAInvestments ScheduleAInvestment[]
  scheduleBRealEstate  ScheduleBRealEstate[]
  scheduleCdeIncome    ScheduleCdeIncome[]
  scheduleA2Positions  ScheduleA2BusinessPosition[]

  @@index([jurisdictionId], map: "politicians_jurisdiction_id_idx")
  @@map("politicians")
}

/// Durable audit trail for administrator approval and duplicate reconciliation.
/// `sourcePoliticianId` is intentionally not a foreign key because a successful
/// merge deletes that source profile; its unique value makes merge retries
/// idempotent.
model PoliticianReviewEvent {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  politicianId        String   @map("politician_id") @db.Uuid
  sourcePoliticianId  String?  @unique @map("source_politician_id") @db.Uuid
  action              String
  adminUserId         String   @map("admin_user_id")
  details             Json?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([politicianId, createdAt], map: "politician_review_events_politician_created_idx")
  @@map("politician_review_events")
}

model Meeting {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jurisdictionId  String       @map("jurisdiction_id") @db.Uuid
  jurisdiction    Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  bodyName        String       @map("body_name")
  meetingDate     DateTime     @map("meeting_date")
  agendaUrl       String?      @map("agenda_url")
  legistarEventId Int?         @map("legistar_event_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  agendaItems AgendaItem[]

  @@index([jurisdictionId], map: "meetings_jurisdiction_id_idx")
  @@index([meetingDate], map: "meetings_meeting_date_idx")
  @@map("meetings")
}

/// Agenda items arrive from three ingestion paths (Legistar REST, Apify, PDF).
/// Raw ingestion inserts rows without a Meeting, so `meetingId` and `title` are
/// nullable and the denormalised Legistar/PDF columns live directly on the row.
model AgendaItem {
  isDemo      Boolean   @default(false) @map("is_demo")
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId   String?   @map("meeting_id") @db.Uuid
  meeting     Meeting?  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title       String?
  description String?
  itemNumber  String?   @map("item_number")
  /// legistar | apify | pdf
  sourceType  String    @default("legistar") @map("source_type")
  /// Raw agenda text for a single item (PDF / Apify sources).
  itemText    String?   @map("item_text")
  /// Original agenda document URL for traceability and admin review.
  sourceUrl   String?   @map("source_url")
  /// Free-form city identifier used by the PDF/Apify pipelines before a
  /// Jurisdiction row exists.
  cityId      String?   @map("city_id")
  cityName    String?   @map("city_name")
  bodyName    String?   @map("body_name")
  meetingDate DateTime? @map("meeting_date")

  // Legistar REST fields written by server/src/jobs/nightlySync.js
  legistarItemId      String?  @unique @map("legistar_item_id")
  legistarEventId     String?  @map("legistar_event_id")
  legistarMatterId    String?  @map("legistar_matter_id")
  agendaNumber        String?  @map("agenda_number")
  eventItemPassedFlag Boolean? @map("event_item_passed_flag")
  legistarItemPayload Json?    @map("legistar_item_payload")

  createdAt DateTime @default(now()) @map("created_at")

  votes         VoteRecord[]
  conflictFlags ConflictFlag[]
  conflicts     Conflict[]

  @@index([meetingId], map: "agenda_items_meeting_id_idx")
  @@index([meetingDate], map: "agenda_items_meeting_date_idx")
  @@index([cityName, meetingDate], map: "agenda_items_city_name_meeting_date_idx")
  @@index([cityId, meetingDate], map: "agenda_items_city_id_meeting_date_idx")
  @@index([sourceType], map: "agenda_items_source_type_idx")
  @@unique([cityId, meetingDate, itemNumber])
  @@map("agenda_items")
}

model VoteRecord {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agendaItemId String     @map("agenda_item_id") @db.Uuid
  agendaItem   AgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  politicianId String     @map("politician_id") @db.Uuid
  politician   Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  vote         String
  voteDate     DateTime?  @map("vote_date")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([agendaItemId, politicianId])
  @@index([agendaItemId], map: "vote_records_agenda_item_id_idx")
  @@index([politicianId], map: "vote_records_politician_id_idx")
  @@map("vote_records")
}

model Form700Filing {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  politicianId     String     @map("politician_id") @db.Uuid
  politician       Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  filingYear       Int        @map("filing_year")
  /// Filer name exactly as printed on the cover page (before entity resolution).
  filerName        String?    @map("filer_name")
  /// Original upload filename (e.g. "smith-2025.xlsx").
  originalFilename String?    @map("original_filename")
  /// Path inside the private `form700-uploads` Supabase Storage bucket.
  archivedPath     String?    @map("archived_path")
  /// Legacy v1 column kept for backwards compatibility; prefer archivedPath.
  storagePath      String?    @map("storage_path")
  filedAt          DateTime?  @map("filed_at")
  importMetadata   Json?      @map("import_metadata")
  createdAt        DateTime   @default(now()) @map("created_at")

  scheduleAInvestments ScheduleAInvestment[]
  scheduleBRealEstate  ScheduleBRealEstate[]
  scheduleCdeIncome    ScheduleCdeIncome[]
  scheduleA2Positions  ScheduleA2BusinessPosition[]

  @@unique([politicianId, filingYear])
  @@map("form700_filings")
}

model ConflictFlag {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  politicianId String      @map("politician_id") @db.Uuid
  politician   Politician  @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  agendaItemId String?     @map("agenda_item_id") @db.Uuid
  agendaItem   AgendaItem? @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  severity     String
  status       String      @default("OPEN")
  summary      String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @map("updated_at")

  @@index([politicianId], map: "conflict_flags_politician_id_idx")
  @@index([agendaItemId], map: "conflict_flags_agenda_item_id_idx")
  @@index([status], map: "conflict_flags_status_idx")
  @@map("conflict_flags")
}

model Conflict {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  politicianId  String       @map("politician_id") @db.Uuid
  politician    Politician   @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  agendaItemId  String       @map("agenda_item_id") @db.Uuid
  agendaItem    AgendaItem   @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  conflictType  String       @map("conflict_type")
  severity      String
  ruleReference String       @map("rule_reference")
  entityName    String?      @map("entity_name")
  sourceKey     String       @map("source_key")
  detectedAt    DateTime     @default(now()) @map("detected_at") @db.Timestamptz(3)
  reviewStatus  String       @default("pending") @map("review_status")
  reviewNote    String?      @map("review_note")
  reviewedAt    DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  reviews       ConflictReview[]

  @@unique([politicianId, agendaItemId, conflictType, sourceKey], map: "conflicts_identity_key")
  @@index([politicianId], map: "conflicts_politician_id_idx")
  @@index([agendaItemId], map: "conflicts_agenda_item_id_idx")
  @@index([detectedAt], map: "conflicts_detected_at_idx")
  @@index([politicianId, detectedAt], map: "conflicts_politician_detected_at_idx")
  @@index([agendaItemId, detectedAt], map: "conflicts_agenda_item_detected_at_idx")
  @@index([politicianId, agendaItemId], map: "conflicts_politician_agenda_item_idx")
  @@index([conflictType], map: "conflicts_conflict_type_idx")
  @@map("conflicts")
}

model ConflictReview {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conflictId  String   @map("conflict_id") @db.Uuid
  conflict    Conflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  adminUserId String   @map("admin_user_id")
  reviewedAt  DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(3)
  oldStatus   String   @map("old_status")
  newStatus   String   @map("new_status")
  note        String

  @@index([conflictId, reviewedAt(sort: Desc)], map: "conflict_reviews_conflict_id_reviewed_at_idx")
  @@map("conflict_reviews")
}

model ScheduleAInvestment {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filingId          String          @map("filing_id") @db.Uuid
  filing            Form700Filing   @relation(fields: [filingId], references: [id], onDelete: Cascade)
  politicianId      String?         @map("politician_id") @db.Uuid
  politician        Politician?     @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  entityName        String          @map("entity_name")
  fairMarketValue   String?         @map("fair_market_value")
  natureOfInvestment String?        @map("nature_of_investment")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([filingId], map: "schedule_a_investments_filing_id_idx")
  @@index([politicianId], map: "schedule_a_investments_politician_id_idx")
  @@map("schedule_a_investments")
}

model ScheduleBRealEstate {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filingId            String        @map("filing_id") @db.Uuid
  filing              Form700Filing @relation(fields: [filingId], references: [id], onDelete: Cascade)
  politicianId        String?       @map("politician_id") @db.Uuid
  politician          Politician?   @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  propertyDescription String?       @map("property_description")
  city                String?
  county              String?
  fairMarketValue     String?       @map("fair_market_value")
  natureOfInterest    String?       @map("nature_of_interest")
  createdAt           DateTime      @default(now()) @map("created_at")

  @@index([filingId], map: "schedule_b_realestate_filing_id_idx")
  @@index([politicianId], map: "schedule_b_realestate_politician_id_idx")
  @@map("schedule_b_realestate")
}

model ScheduleCdeIncome {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filingId     String        @map("filing_id") @db.Uuid
  filing       Form700Filing @relation(fields: [filingId], references: [id], onDelete: Cascade)
  politicianId String?       @map("politician_id") @db.Uuid
  politician   Politician?   @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  scheduleType String        @map("schedule_type")
  sourceName   String?       @map("source_name")
  amount       String?
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([filingId], map: "schedule_cde_income_filing_id_idx")
  @@index([politicianId], map: "schedule_cde_income_politician_id_idx")
  @@index([scheduleType], map: "schedule_cde_income_schedule_type_idx")
  @@map("schedule_cde_income")
}

model ScheduleA2BusinessPosition {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filingId           String        @map("filing_id") @db.Uuid
  filing             Form700Filing @relation(fields: [filingId], references: [id], onDelete: Cascade)
  politicianId       String?       @map("politician_id") @db.Uuid
  politician         Politician?   @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  entityName         String        @map("entity_name")
  businessPosition   String?       @map("business_position")
  fairMarketValue    String?       @map("fair_market_value")
  natureOfInvestment String?       @map("nature_of_investment")
  grossIncomeRange   String?       @map("gross_income_range")
  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([filingId], map: "schedule_a2_business_positions_filing_id_idx")
  @@index([politicianId], map: "schedule_a2_business_positions_politician_id_idx")
  @@map("schedule_a2_business_positions")
}

model DataSource {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityName        String        @map("city_name")
  sourceType      String        @map("source_type")
  legistarBaseUrl String?       @map("legistar_base_url")
  legistarClientId String?      @map("legistar_client_id")
  apifyActorId    String?       @map("apify_actor_id")
  startUrl        String?       @map("start_url")
  enabled         Boolean       @default(true)
  lastSyncedAt    DateTime?     @map("last_synced_at")
  lastError       String?       @map("last_error")
  jurisdictionId  String?       @map("jurisdiction_id") @db.Uuid
  jurisdiction    Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @map("updated_at")
  syncLogs        SyncLog[]

  @@index([sourceType, enabled], map: "data_sources_source_type_enabled_idx")
  @@map("data_sources")
}

model SyncLog {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dataSourceId    String?     @map("data_source_id") @db.Uuid
  dataSource      DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  sourceType      String?     @map("source_type")
  status          String      @default("running")
  startedAt       DateTime    @default(now()) @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  itemsFound      Int         @default(0) @map("items_found")
  itemsInserted   Int         @default(0) @map("items_inserted")
  itemsSkipped    Int         @default(0) @map("items_skipped")
  conflictCandidates Int      @default(0) @map("conflict_candidates")
  conflictsDetected Int       @default(0) @map("conflicts_detected")
  conflictsSkipped Int        @default(0) @map("conflicts_skipped")
  detectionErrors Json?       @map("detection_errors")
  errors          Json?

  @@index([dataSourceId, startedAt], map: "sync_logs_data_source_id_started_at_idx")
  @@index([startedAt], map: "sync_logs_started_at_idx")
  @@map("sync_logs")
}
